rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuiUser() {
      // Mailbox control is proven before any data access: the domain match alone is
      // only a claim, since Firebase lets a client register any address it likes.
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@aui\\.ma');
    }

    match /users/{userId} {
      function isOwner() {
        return isAuiUser() && request.auth.uid == userId;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner()
        && !request.resource.data.keys().hasAny(['aiUsage']);
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiUsage']);

      match /noteTemplates/{templateId} {
        allow read, write: if isAuiUser() && request.auth.uid == userId;
      }

      match /classes/{classId} {
        allow read, write: if isAuiUser() && request.auth.uid == userId;

        match /notes/{noteId} {
          allow read, write: if isAuiUser() && request.auth.uid == userId;

          match /content/{contentId} {
            allow read, write: if isAuiUser() && request.auth.uid == userId;
          }
        }
      }
    }

    // Usage counters are maintained only by the Admin SDK in Cloud Functions. They are
    // deliberately outside users/{uid}, whose documents are client-writable.
    match /sageUsage/{userId} {
      allow read, write: if false;
    }

    match /deleteUsage/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
